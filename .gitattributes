# Without this, every site that installs the addon downloads its tests and CI
# config. Keep: /config, /lang, /resources/dist, /routes, /src, README.md,
# CHANGELOG.md, LICENSE.md.

/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/phpunit.xml        export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon       export-ignore
/pint.json          export-ignore
/addon-lint.json    export-ignore
/resources/js       export-ignore
/scripts            export-ignore

# The browser test harness. /tests is already ignored above; these two are what
# would otherwise make every installing site download playwright.
/package.json       export-ignore
/package-lock.json  export-ignore
/vite.config.js     export-ignore

# Pictures: 1.7 MB that no installed site ever displays. The README renders
# on GitHub, on Packagist and in the marketplace listing, all three of which
# read the repository, not the composer tarball; the cover and the icon are
# pulled out of the repository too, by the docs site's own render script. The
# family is split on this, 16 repos ignore /art and 11 ship it. Ignoring it is
# the side with the argument.
/art                export-ignore
/screenshots        export-ignore
